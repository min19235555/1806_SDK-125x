#!/bin/sh
# CPE1252S modem policy:
#   - data path: Quectel RG200U-CN in ECM mode, network device usb0
#   - AT management: ttyUSB2 only (USB interface 4), no PCIe scan
# QMODEM creates the wan uplink; do not add a second DHCP client on usb0.
uci -q set qmodem.main.enable_dial=1
uci -q set qmodem.main.try_preset_usb=1
uci -q set qmodem.main.try_preset_pcie=0
uci -q set qmodem.main.enable_pcie_scan=0
uci -q set qmodem.main.enable_usb_scan=1
uci -q set qmodem.main.at_only_usb2=1
uci -q commit qmodem
rm -f "$0"
exit 0
