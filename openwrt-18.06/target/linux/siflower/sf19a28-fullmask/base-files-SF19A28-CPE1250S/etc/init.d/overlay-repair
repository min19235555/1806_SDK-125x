#!/bin/sh
# Self-heal a poisoned rootfs_data partition (CPE1250S / CPE1252S).
#
# Background (see "CPE1250S 开机异常修复总结"):
#   The sysupgrade image tail carries the JFFS2 end marker (deadc0de). If
#   rootfs_data was previously overwritten with non-JFFS2 data, fstools sees
#   a non-8519 first bytes and falls back to a tmpfs overlay. Every config
#   write then lands in /tmp/root and is lost on reboot. The first JFFS2
#   init can also leave /etc/rc.common as a whiteout, so netifd/dnsmasq/etc.
#   never start.
#
# Two phases, both edge-triggered and idempotent:
#   A) overlay is tmpfs and rootfs_data magic != 85 19:
#      erase + jffs2write rootfs_data, then reboot once to activate it.
#   B) overlay is real JFFS2:
#      ensure /overlay/.fs_state exists (else every boot wipes upperdir)
#      and restore /etc/rc.common if a whiteout masked it.
# A healthy board is a complete no-op (a couple of cheap reads).

START=09
STOP=91

RD_LABEL="rootfs_data"
RD_MTD=""
_MAGIC=""

mtd_index() {
	local line n
	[ -r /proc/mtd ] || return 1
	while read -r line; do
		case "$line" in
			mtd*:*)
				n=${line%%:*}
				case "$line" in *"\"$1\""*) echo "$n"; return 0 ;; esac
				;;
		esac
	done < /proc/mtd
	return 1
}

read_magic() {
	dd if="/dev/$1" bs=1 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

overlay_is_tmpfs() {
	grep -q 'overlayfs:/tmp/root' /proc/mounts 2>/dev/null && return 0
	if grep -q ' /overlay ' /proc/mounts 2>/dev/null; then
		grep -q ' /overlay .*jffs2' /proc/mounts 2>/dev/null || return 0
	fi
	return 1
}

phase_a() {
	RD_MTD=$(mtd_index "$RD_LABEL") || return 1
	[ -n "$RD_MTD" ] || return 1
	_MAGIC=$(read_magic "$RD_MTD")
	[ "$_MAGIC" = "8519" ] && return 0   # not actually poisoned

	logger -t overlay-repair "rootfs_data=${_MAGIC:-empty} (not JFFS2), tmpfs overlay - phase A"

	mtd unlock "$RD_LABEL" >/dev/null 2>&1
	mtd erase "$RD_LABEL" >/dev/null 2>&1
	printf 'overlay-repair\n' > /tmp/.overlay_repair_payload
	mtd jffs2write /tmp/.overlay_repair_payload "$RD_LABEL" >/dev/null 2>&1
	rm -f /tmp/.overlay_repair_payload

	_MAGIC=$(read_magic "$RD_MTD")
	if [ "$_MAGIC" != "8519" ]; then
		logger -t overlay-repair "FAILED: magic after repair=${_MAGIC:-empty}"
		return 1
	fi

	# Best effort in the current tmpfs overlay (lost on reboot, but harmless).
	[ -d /overlay ] && ln -s 2 /overlay/.fs_state 2>/dev/null
	logger -t overlay-repair "phase A OK (85 19); rebooting to switch to JFFS2 overlay"
	# Defer so this init script can finish; procd starts moments later.
	( sleep 3; sync; reboot ) >/dev/null 2>&1 &
	return 0
}

phase_b() {
	# .fs_state missing -> mount_root wipes the upperdir at every boot.
	if [ -d /overlay ] && [ ! -e /overlay/.fs_state ]; then
		ln -s 2 /overlay/.fs_state 2>/dev/null
		logger -t overlay-repair "phase B: created /overlay/.fs_state"
	fi
	# A JFFS2 whiteout can mask the read-only /etc/rc.common, killing all
	# rc.d services (netifd/dnsmasq/firewall/uhttpd).
	if [ ! -r /etc/rc.common ] && [ -r /rom/etc/rc.common ]; then
		mkdir -p /overlay/upper/etc 2>/dev/null
		rm -f /overlay/upper/etc/rc.common 2>/dev/null
		cp /rom/etc/rc.common /overlay/upper/etc/rc.common 2>/dev/null
		logger -t overlay-repair "phase B: restored /etc/rc.common from /rom"
	fi
	return 0
}

boot() {
	if overlay_is_tmpfs; then
		phase_a
	else
		phase_b
	fi
	return 0
}

start() { :; }
