#!/bin/sh /etc/rc.common
# Power-up sequence for the Quectel 5G module on the CPE1250S.
# ON/OFF: GPIO46 (pulse low for 1 s, then high)
# RESET_N: GPIO47 (active low, deasserted at boot)
START=10

power_on() {
	[ -f /tmp/.modem_powered ] && return 0

	for g in 46 47; do
		[ -d /sys/class/gpio/gpio$g ] || echo $g > /sys/class/gpio/export 2>/dev/null
	done

	echo out > /sys/class/gpio/gpio47/direction 2>/dev/null
	echo 0 > /sys/class/gpio/gpio47/value 2>/dev/null

	echo out > /sys/class/gpio/gpio46/direction 2>/dev/null
	echo 1 > /sys/class/gpio/gpio46/value 2>/dev/null
	sleep 1
	echo 0 > /sys/class/gpio/gpio46/value 2>/dev/null
	sleep 1
	echo 1 > /sys/class/gpio/gpio46/value 2>/dev/null

	touch /tmp/.modem_powered
}

start() {
	power_on
}
